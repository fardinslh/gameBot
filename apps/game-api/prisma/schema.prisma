generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  BALE
  TELEGRAM
  WEB
}

enum KingdomRulerTitle {
  LORD
  LADY
  WARDEN
}

enum KingdomHeraldry {
  GOLDEN_LION
  VERDANT_STAG
  CRIMSON_FALCON
}

enum AnalyticsSource {
  SERVER
  CLIENT
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum OnboardingStep {
  WELCOME
  COLLECT
  UPGRADE
  RAID
  COMPLETE
}

enum ResourceType {
  GOLD
  FOOD
  WOOD
  STONE
  GEMS
}

enum BuildingType {
  CASTLE
  FARM
  LUMBER_MILL
  MINE
  GRAND_MARKET
  BARRACKS
  BLACKSMITH
  ACADEMY
  WATCHTOWER
  WORKSHOP
  WALL
}

enum EconomyTransactionReason {
  OFFLINE_PRODUCTION
  BUILDING_UPGRADE
  HERO_UPGRADE
  ADMIN_OR_SEED
  RAID_REWARD
  RAID_LOSS
  QUEST_REWARD
  PURCHASE
  SYSTEM_OPPONENT_REPLENISH
  MISSION_REWARD
  WEEKLY_MISSION_REWARD
  ACHIEVEMENT_REWARD
  DAILY_RETURN_REWARD
  DAILY_COMPLETION_REWARD
  TROOP_TRAINING
  CAMPAIGN_REWARD
  CAMPAIGN_STAR_REWARD
  SHOP_GEM_SPEND
  ROYAL_DECREE_REWARD
  LEAGUE_WIN_BONUS
  GUILD_CREATE
  GUILD_DONATION_REWARD
  GUILD_WAR_SPOILS
  SEASON_REWARD
  GUILD_TREASURY_DONATE
}

enum EconomyAction {
  COLLECT
  UPGRADE
  UPGRADE_COLLECT
  HERO_UPGRADE
  RAID_START
  REVENGE_START
  MISSION_CLAIM
  DAILY_BONUS_CLAIM
  ACHIEVEMENT_CLAIM
  DAILY_RETURN_CLAIM
  TROOP_TRAINING
  CAMPAIGN_START
  CAMPAIGN_STAR_REWARD
  SHOP_PURCHASE
  ENGAGEMENT_SESSION
  ROYAL_DECREE_CLAIM
  GUILD_CREATE
  GUILD_DONATE
  GUILD_WAR_SPOILS_CLAIM
  SEASON_REWARD_CLAIM
  GUILD_TREASURY_DONATE
}

enum SeasonStatus {
  ACTIVE
  FINALIZING
  ENDED
}

enum TrophyLeague {
  BRONZE
  SILVER
  GOLD
  CRYSTAL
  MASTER
  CHAMPION
}

enum ShopCategory {
  CONVENIENCE
  COSMETICS
}

enum ShopFulfillmentType {
  PROFILE_CREST
  BUILDING_FINISH
  TROOP_TRAINING_FINISH
}

enum EntitlementSource {
  SHOP
}

enum ProfileCrestKey {
  DEFAULT
  PROFILE_CREST_FOREST
  PROFILE_CREST_CRIMSON
  PROFILE_CREST_ROYAL
}

enum SystemOpponentKind {
  RAID
  CAMPAIGN
}

enum TroopType {
  INFANTRY
  ARCHER
  CAVALRY
}

enum TroopTrainingStatus {
  IN_PROGRESS
  COMPLETED
}

enum RetentionCadence {
  DAILY
  WEEKLY
}

enum BattleType {
  RAID
  REVENGE
  CAMPAIGN
}

enum RevengeStatus {
  AVAILABLE
  USED
  EXPIRED
  INVALID
}

enum NotificationType {
  PLAYER_RAIDED
  REVENGE_AVAILABLE
  UPGRADE_COMPLETE
}

enum NotificationDeliveryStatus {
  STORED
}

enum BattleStatus {
  CREATED
  RESOLVED
  REWARDED
}

enum GuildJoinPolicy {
  OPEN
  INVITE_ONLY
  CLOSED
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

enum GuildTroopRequestStatus {
  OPEN
  FULFILLED
  EXPIRED
}

enum BattleSide {
  ATTACKER
  DEFENDER
}

enum BattleResult {
  ATTACKER_WIN
  DEFENDER_WIN
}

enum BattleEventType {
  BATTLE_START
  BASIC_ATTACK
  SKILL_CAST
  DAMAGE
  BUFF_APPLIED
  BUFF_EXPIRED
  HERO_DEFEATED
  SQUAD_DEFEATED
  BATTLE_END
}

enum HeroKey {
  KNIGHT
  RANGER
  MAGE
}

enum HeroClass {
  TANK
  SINGLE_TARGET_DPS
  AOE_BURST
}

enum UpgradeStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Player {
  id                    String                      @id @default(uuid())
  displayName           String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  trophies              Int                         @default(1000)
  isSystemOpponent      Boolean                     @default(false)
  systemOpponentKind    SystemOpponentKind?
  platformAccounts      PlatformAccount[]
  kingdom               Kingdom?
  economyTransactions   EconomyTransaction[]
  economyRequests       EconomyRequest[]
  heroes                PlayerHero[]
  raidTeam              RaidTeam?
  raidOffersCreated     RaidMatchOffer[]            @relation("RaidOfferAttacker")
  raidOffersReceived    RaidMatchOffer[]            @relation("RaidOfferDefender")
  battlesAttacked       Battle[]                    @relation("BattleAttacker")
  battlesDefended       Battle[]                    @relation("BattleDefender")
  battlesWon            Battle[]                    @relation("BattleWinner")
  revengeTargetsOwned   RevengeTarget[]             @relation("RevengeOwner")
  revengeTargetsAgainst RevengeTarget[]             @relation("RevengeTargetPlayer")
  notifications         Notification[]
  analyticsEvents       AnalyticsEvent[]
  onboarding            OnboardingProgress?
  advisorTips           AdvisorTipProgress[]
  retentionMissions     RetentionMissionInstance[]
  dailyBonusClaims      RetentionDailyBonusClaim[]
  achievementClaims     RetentionAchievementClaim[]
  dailyReturnClaims     DailyReturnClaim[]
  troops                PlayerTroop[]
  troopTrainingOrders   TroopTrainingOrder[]
  armyFormation         ArmyFormation?
  campaignStages        PlayerCampaignStage[]
  campaignRewardClaims  CampaignRewardClaim[]
  entitlements          PlayerEntitlement[]
  shopPurchases         ShopPurchase[]
  equippedProfileCrest  ProfileCrestKey             @default(DEFAULT)
  engagement            PlayerEngagementState?
  guildMembership       GuildMember?
  guildDonationRequests GuildTroopRequest[]         @relation("GuildRequestRequester")
  guildDonationsGiven   GuildTroopDonation[]        @relation("GuildDonationDonor")
  warParticipants       GuildWarParticipant[]
  warAttacksMade        GuildWarAttack[]            @relation("WarAttacker")
  warAttacksTaken       GuildWarAttack[]            @relation("WarDefender")
  seasonRecords         PlayerSeasonRecord[]
  guildTreasuryDonations GuildTreasuryDonation[]    @relation("GuildTreasuryDonor")
  sentGuildChatMessages  GuildChatMessage[]         @relation("GuildChatSender")
  claimedWarCallouts    GuildWarCallout[]           @relation("WarCalloutClaimedBy")
  assignedWarCallouts   GuildWarCallout[]           @relation("WarCalloutAssignedBy")
  createdFriendlyChallenges GuildFriendlyChallenge[] @relation("CreatedFriendlyChallenges")
  attackedFriendlyChallenges GuildFriendlyChallenge[] @relation("AttackedFriendlyChallenges")

  @@index([isSystemOpponent, trophies, createdAt])
}

model PlayerEngagementState {
  id                   String    @id @default(uuid())
  playerId             String    @unique
  lastSeenAt           DateTime
  royalDecreeClaimedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  player               Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
}

model PlayerEntitlement {
  id                String            @id @default(uuid())
  playerId          String
  entitlementKey    String
  source            EntitlementSource
  sourceReferenceId String
  createdAt         DateTime          @default(now())
  player            Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, entitlementKey])
  @@index([sourceReferenceId])
}

model ShopPurchase {
  id              String              @id @default(uuid())
  playerId        String
  itemKey         String
  category        ShopCategory
  fulfillmentType ShopFulfillmentType
  gemPrice        Int
  targetType      String?
  targetId        String?
  createdAt       DateTime            @default(now())
  player          Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([targetId])
}

model OnboardingProgress {
  id          String           @id @default(uuid())
  playerId    String           @unique
  status      OnboardingStatus @default(NOT_STARTED)
  currentStep OnboardingStep   @default(WELCOME)
  startedAt   DateTime?
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  player      Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model AdvisorTipProgress {
  id        String   @id @default(uuid())
  playerId  String
  tipKey    String
  seenAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, tipKey])
  @@index([playerId, seenAt])
}

model AnalyticsEvent {
  id                String          @id @default(uuid())
  dedupeKey         String?         @unique
  playerId          String
  sessionId         String?
  source            AnalyticsSource
  eventName         String
  schemaVersion     Int             @default(1)
  platform          Platform
  locale            String?
  appVersion        String?
  acquisitionSource String?
  properties        Json
  occurredAt        DateTime        @default(now())
  clientOccurredAt  DateTime?
  player            Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([playerId, eventName, occurredAt])
  @@index([acquisitionSource, occurredAt])
}

model PlatformAccount {
  id             String    @id @default(uuid())
  playerId       String
  platform       Platform
  externalUserId String
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([platform, externalUserId])
  @@index([playerId])
}

model Kingdom {
  id                  String               @id @default(uuid())
  playerId            String               @unique
  name                String
  rulerTitle          KingdomRulerTitle    @default(LORD)
  heraldry            KingdomHeraldry      @default(GOLDEN_LION)
  level               Int                  @default(1)
  lastCollectedAt     DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  player              Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resourceBalances    ResourceBalance[]
  buildings           Building[]
  economyTransactions EconomyTransaction[]
}

model ResourceBalance {
  id           String               @id @default(uuid())
  kingdomId    String
  resource     ResourceType
  amount       BigInt               @default(0)
  updatedAt    DateTime             @updatedAt
  kingdom      Kingdom              @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  transactions EconomyTransaction[]

  @@unique([kingdomId, resource])
}

model Building {
  id                  String            @id @default(uuid())
  kingdomId           String
  type                BuildingType
  level               Int               @default(1)
  productionRemainder BigInt            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  kingdom             Kingdom           @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  upgrades            BuildingUpgrade[]

  @@unique([kingdomId, type])
}

model EconomyTransaction {
  id            String                   @id @default(uuid())
  playerId      String
  kingdomId     String
  balanceId     String
  resourceType  ResourceType
  delta         BigInt
  balanceBefore BigInt
  balanceAfter  BigInt
  reason        EconomyTransactionReason
  referenceId   String
  createdAt     DateTime                 @default(now())
  player        Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kingdom       Kingdom                  @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  balance       ResourceBalance          @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@index([playerId, createdAt])
  @@index([referenceId])
}

model EconomyRequest {
  id             String        @id @default(uuid())
  playerId       String
  idempotencyKey String
  action         EconomyAction
  response       Json
  createdAt      DateTime      @default(now())
  player         Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, idempotencyKey, action])
  @@index([createdAt])
}

model RetentionMissionInstance {
  id            String           @id @default(uuid())
  playerId      String
  cadence       RetentionCadence
  periodKey     String
  definitionKey String
  target        BigInt
  rewards       Json
  claimedAt     DateTime?
  createdAt     DateTime         @default(now())
  player        Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, cadence, periodKey, definitionKey])
  @@index([playerId, cadence, periodKey])
}

model RetentionDailyBonusClaim {
  id        String   @id @default(uuid())
  playerId  String
  periodKey String
  rewards   Json
  claimedAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, periodKey])
  @@index([claimedAt])
}

model RetentionAchievementClaim {
  id             String   @id @default(uuid())
  playerId       String
  achievementKey String
  tier           Int
  target         BigInt
  rewards        Json
  claimedAt      DateTime @default(now())
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, achievementKey, tier])
  @@index([playerId, achievementKey])
}

model DailyReturnClaim {
  id        String   @id @default(uuid())
  playerId  String
  periodKey String
  dayIndex  Int
  rewards   Json
  claimedAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, periodKey])
  @@index([playerId, claimedAt])
}

model BuildingUpgrade {
  id          String        @id @default(uuid())
  buildingId  String
  fromLevel   Int
  toLevel     Int
  status      UpgradeStatus @default(QUEUED)
  queuedAt    DateTime      @default(now())
  startedAt   DateTime?
  completesAt DateTime?
  completedAt DateTime?
  building    Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId, status])
}

model HeroDefinition {
  id            String       @id @default(uuid())
  key           HeroKey      @unique
  combatClass   HeroClass
  baseHp        Int
  baseAtk       Int
  baseDef       Int
  hpGrowthBps   Int
  atkGrowthBps  Int
  defGrowthBps  Int
  skillKey      String
  portraitAsset String
  sortOrder     Int
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  playerHeroes  PlayerHero[]

  @@index([enabled, sortOrder])
}

model PlayerHero {
  id                 String              @id @default(uuid())
  playerId           String
  heroDefinitionId   String
  level              Int                 @default(1)
  xp                 Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  player             Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  heroDefinition     HeroDefinition      @relation(fields: [heroDefinitionId], references: [id], onDelete: Restrict)
  raidTeamSlots      RaidTeamSlot[]
  armyFormationSlots ArmyFormationSlot[]

  @@unique([playerId, heroDefinitionId])
  @@index([playerId])
}

model PlayerTroop {
  id         String    @id @default(uuid())
  playerId   String
  troopType  TroopType
  readyCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, troopType])
  @@index([playerId])
}

model TroopTrainingOrder {
  id           String              @id @default(uuid())
  playerId     String
  troopType    TroopType
  quantity     Int
  status       TroopTrainingStatus @default(IN_PROGRESS)
  costSnapshot Json
  startedAt    DateTime
  completesAt  DateTime
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  player       Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([status, completesAt])
}

model ArmyFormation {
  id        String              @id @default(uuid())
  playerId  String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  player    Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slots     ArmyFormationSlot[]
}

model ArmyFormationSlot {
  id                    String        @id @default(uuid())
  armyFormationId       String
  slot                  Int
  troopType             TroopType
  unitCount             Int
  commanderPlayerHeroId String
  armyFormation         ArmyFormation @relation(fields: [armyFormationId], references: [id], onDelete: Cascade)
  commander             PlayerHero    @relation(fields: [commanderPlayerHeroId], references: [id], onDelete: Cascade)

  @@unique([armyFormationId, slot])
  @@unique([armyFormationId, commanderPlayerHeroId])
  @@index([commanderPlayerHeroId])
}

model RaidTeam {
  id        String         @id @default(uuid())
  playerId  String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slots     RaidTeamSlot[]
}

model RaidTeamSlot {
  id           String     @id @default(uuid())
  raidTeamId   String
  playerHeroId String
  slot         Int
  raidTeam     RaidTeam   @relation(fields: [raidTeamId], references: [id], onDelete: Cascade)
  playerHero   PlayerHero @relation(fields: [playerHeroId], references: [id], onDelete: Cascade)

  @@unique([raidTeamId, slot])
  @@unique([raidTeamId, playerHeroId])
  @@index([playerHeroId])
}

model RaidMatchOffer {
  id                      String    @id @default(uuid())
  attackerPlayerId        String
  defenderPlayerId        String
  attackerPower           Int
  attackerArmyFingerprint String?
  defenderPower           Int
  potentialLoot           Json
  createdAt               DateTime  @default(now())
  expiresAt               DateTime
  usedAt                  DateTime?
  attacker                Player    @relation("RaidOfferAttacker", fields: [attackerPlayerId], references: [id], onDelete: Cascade)
  defender                Player    @relation("RaidOfferDefender", fields: [defenderPlayerId], references: [id], onDelete: Cascade)
  battle                  Battle?

  @@index([attackerPlayerId, createdAt])
  @@index([defenderPlayerId, createdAt])
  @@index([expiresAt])
}

model Battle {
  id                   String                    @id @default(uuid())
  matchOfferId         String?                   @unique
  revengeTargetId      String?                   @unique
  campaignStageKey     String?
  type                 BattleType                @default(RAID)
  status               BattleStatus              @default(CREATED)
  attackerPlayerId     String
  defenderPlayerId     String
  winnerPlayerId       String
  result               BattleResult
  seed                 String
  rulesVersion         Int
  durationMs           Int
  attackerTrophyBefore Int
  defenderTrophyBefore Int
  attackerTrophyDelta  Int
  defenderTrophyDelta  Int
  loot                 Json
  startedAt            DateTime
  resolvedAt           DateTime
  createdAt            DateTime                  @default(now())
  matchOffer           RaidMatchOffer?           @relation(fields: [matchOfferId], references: [id], onDelete: Restrict)
  revengeTarget        RevengeTarget?            @relation("RevengeBattle", fields: [revengeTargetId], references: [id], onDelete: Restrict)
  revengeSource        RevengeTarget?            @relation("RevengeSourceBattle")
  attacker             Player                    @relation("BattleAttacker", fields: [attackerPlayerId], references: [id], onDelete: Restrict)
  defender             Player                    @relation("BattleDefender", fields: [defenderPlayerId], references: [id], onDelete: Restrict)
  winner               Player                    @relation("BattleWinner", fields: [winnerPlayerId], references: [id], onDelete: Restrict)
  heroSnapshots        BattleHeroSnapshot[]
  armySquadSnapshots   BattleArmySquadSnapshot[]
  events               BattleEvent[]

  @@index([attackerPlayerId, createdAt])
  @@index([defenderPlayerId, createdAt])
  @@index([winnerPlayerId, createdAt])
  @@index([type, createdAt])
  @@index([attackerPlayerId, campaignStageKey, createdAt])
}

model PlayerCampaignStage {
  id             String    @id @default(uuid())
  playerId       String
  stageKey       String
  bestStars      Int       @default(0)
  attempts       Int       @default(0)
  firstClearedAt DateTime?
  lastPlayedAt   DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, stageKey])
  @@index([playerId, lastPlayedAt])
}

model CampaignRewardClaim {
  id             String   @id @default(uuid())
  playerId       String
  chapterKey     String
  milestoneStars Int
  claimedAt      DateTime @default(now())
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, chapterKey, milestoneStars])
  @@index([playerId, claimedAt])
}

model RevengeTarget {
  id             String        @id @default(uuid())
  sourceBattleId String        @unique
  playerId       String
  targetPlayerId String
  status         RevengeStatus @default(AVAILABLE)
  createdAt      DateTime      @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  sourceBattle   Battle        @relation("RevengeSourceBattle", fields: [sourceBattleId], references: [id], onDelete: Restrict)
  player         Player        @relation("RevengeOwner", fields: [playerId], references: [id], onDelete: Cascade)
  targetPlayer   Player        @relation("RevengeTargetPlayer", fields: [targetPlayerId], references: [id], onDelete: Cascade)
  revengeBattle  Battle?       @relation("RevengeBattle")

  @@index([playerId, status, expiresAt])
  @@index([targetPlayerId, createdAt])
}

model Notification {
  id             String                     @id @default(uuid())
  playerId       String
  type           NotificationType
  payload        Json
  deepLinkIntent Json
  sourceKey      String                     @unique
  createdAt      DateTime                   @default(now())
  readAt         DateTime?
  deliveryStatus NotificationDeliveryStatus @default(STORED)
  player         Player                     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, readAt, createdAt])
  @@index([playerId, type, createdAt])
}

model BattleHeroSnapshot {
  id       String     @id @default(uuid())
  battleId String
  side     BattleSide
  slot     Int
  heroKey  HeroKey
  level    Int
  hp       Int
  atk      Int
  def      Int
  power    Int
  skillKey String
  battle   Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, side, slot])
  @@index([battleId, side])
}

model BattleArmySquadSnapshot {
  id                     String     @id @default(uuid())
  battleId               String
  side                   BattleSide
  slot                   Int
  troopType              TroopType
  initialUnitCount       Int
  perUnitHp              Int
  perUnitAtk             Int
  perUnitDef             Int
  aggregateMaxHp         Int
  commanderKey           HeroKey
  commanderLevel         Int
  commanderSkillKey      String
  commanderPower         Int
  commanderPortraitAsset String
  squadPower             Int
  battle                 Battle     @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, side, slot])
  @@index([battleId, side])
}

model BattleEvent {
  id             String          @id @default(uuid())
  battleId       String
  sequence       Int
  timeMs         Int
  type           BattleEventType
  sourceSide     BattleSide?
  sourceSlot     Int?
  targetSide     BattleSide?
  targetSlot     Int?
  amount         Int?
  remainingHp    Int?
  remainingUnits Int?
  skillKey       String?
  battle         Battle          @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, sequence])
  @@index([battleId, timeMs])
}

model Guild {
  id              String                @id @default(uuid())
  name            String                @unique
  tag             String                @unique
  description     String                @default("")
  emblem          String                @default("shield")
  primaryColor    String                @default("#d97706")
  secondaryColor  String                @default("#78350f")
  joinPolicy      GuildJoinPolicy       @default(OPEN)
  minTrophies     Int                   @default(0)
  score           Int                   @default(0)
  level           Int                   @default(1)
  xp              Int                   @default(0)
  warWins         Int                   @default(0)
  warLosses       Int                   @default(0)
  warDraws        Int                   @default(0)
  currentWarId    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  members         GuildMember[]
  requests        GuildTroopRequest[]
  friendlyWars    GuildWar[]            @relation("FriendlyGuildWars")
  opposingWars    GuildWar[]            @relation("OpposingGuildWars")
  warParticipants GuildWarParticipant[]
  attacksMade     GuildWarAttack[]      @relation("AttackerGuildAttacks")
  attacksReceived GuildWarAttack[]      @relation("DefenderGuildAttacks")
  treasuryGold    BigInt                @default(0)
  perks           GuildPerk[]
  treasuryDonations GuildTreasuryDonation[]
  chatMessages    GuildChatMessage[]
  warCallouts     GuildWarCallout[]
  friendlyChallenges GuildFriendlyChallenge[]

  @@index([score(sort: Desc), name])
  @@index([joinPolicy, minTrophies])
}

model GuildMember {
  id                String    @id @default(uuid())
  guildId           String
  playerId          String    @unique
  role              GuildRole @default(MEMBER)
  donationsGiven    Int       @default(0)
  donationsReceived Int       @default(0)
  joinedAt          DateTime  @default(now())
  guild             Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player            Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([guildId, role])
}

model GuildTroopRequest {
  id               String                  @id @default(uuid())
  guildId          String
  requesterId      String
  troopType        TroopType
  currentDonations Int                     @default(0)
  maxDonations     Int                     @default(10)
  status           GuildTroopRequestStatus @default(OPEN)
  createdAt        DateTime                @default(now())
  expiresAt        DateTime
  guild            Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  requester        Player                  @relation("GuildRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  donations        GuildTroopDonation[]

  @@index([guildId, status, createdAt])
  @@index([requesterId, createdAt])
}

model GuildTroopDonation {
  id        String            @id @default(uuid())
  requestId String
  donorId   String
  amount    Int               @default(1)
  createdAt DateTime          @default(now())
  request   GuildTroopRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor     Player            @relation("GuildDonationDonor", fields: [donorId], references: [id], onDelete: Cascade)

  @@index([requestId, donorId])
  @@index([donorId, createdAt])
}

enum GuildWarState {
  NOT_IN_WAR
  PREPARATION
  BATTLE_DAY
  WAR_ENDED
}

enum GuildWarOutcome {
  PENDING
  VICTORY
  DEFEAT
  DRAW
}

model GuildWar {
  id                String                @id @default(uuid())
  guildId1          String
  guildId2          String
  warSize           Int                   @default(5)
  state             GuildWarState         @default(PREPARATION)
  outcome           GuildWarOutcome       @default(PENDING)
  prepEndsAt        DateTime
  battleEndsAt      DateTime
  guild1Stars       Int                   @default(0)
  guild2Stars       Int                   @default(0)
  guild1Destruction Float                 @default(0)
  guild2Destruction Float                 @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  guild1            Guild                 @relation("FriendlyGuildWars", fields: [guildId1], references: [id], onDelete: Cascade)
  guild2            Guild                 @relation("OpposingGuildWars", fields: [guildId2], references: [id], onDelete: Cascade)
  participants      GuildWarParticipant[]
  attacks           GuildWarAttack[]
  callouts          GuildWarCallout[]

  @@index([state, battleEndsAt])
  @@index([guildId1, state])
  @@index([guildId2, state])
}

model GuildWarParticipant {
  id                      String   @id @default(uuid())
  warId                   String
  guildId                 String
  playerId                String
  baseNumber              Int
  attacksUsed             Int      @default(0)
  bestStarsConceded       Int      @default(0)
  bestDestructionConceded  Float    @default(0)
  war                     GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  guild                   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([warId, playerId])
  @@index([warId, guildId, baseNumber])
  @@index([playerId])
}

model GuildWarAttack {
  id              String   @id @default(uuid())
  warId           String
  attackerId      String
  defenderId      String
  attackerGuildId String
  defenderGuildId String
  stars           Int
  destructionPct  Float
  spoilsGold      BigInt   @default(0)
  timeMs          Int      @default(0)
  replayData      Json?
  createdAt       DateTime @default(now())
  war             GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  attacker        Player   @relation("WarAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender        Player   @relation("WarDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  attackerGuild   Guild    @relation("AttackerGuildAttacks", fields: [attackerGuildId], references: [id], onDelete: Cascade)
  defenderGuild   Guild    @relation("DefenderGuildAttacks", fields: [defenderGuildId], references: [id], onDelete: Cascade)

  @@index([warId, attackerId])
  @@index([warId, defenderId])
  @@index([warId, createdAt])
}

model Season {
  id            String               @id @default(uuid())
  seasonNumber  Int                  @unique
  name          String
  status        SeasonStatus         @default(ACTIVE)
  startsAt      DateTime
  endsAt        DateTime
  playerRecords PlayerSeasonRecord[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, endsAt])
}

model PlayerSeasonRecord {
  id               String        @id @default(uuid())
  playerId         String
  seasonId         String
  startingTrophies Int           @default(0)
  peakTrophies     Int           @default(0)
  endingTrophies   Int?
  endingLeague     TrophyLeague?
  rewardsClaimed   Boolean       @default(false)
  claimedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  player           Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season           Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
  @@index([seasonId, playerId])
}

enum GuildPerkType {
  GOLD_BOOST
  DONATION_CAPACITY
  WAR_LOOT_BONUS
  TROOP_TRAINING_SPEED
}

model GuildPerk {
  id         String        @id @default(uuid())
  guildId    String
  perkType   GuildPerkType
  level      Int           @default(1)
  unlockedAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  guild      Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, perkType])
  @@index([guildId])
}

model GuildTreasuryDonation {
  id        String   @id @default(uuid())
  guildId   String
  donorId   String
  amount    BigInt
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  donor     Player   @relation("GuildTreasuryDonor", fields: [donorId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([donorId, createdAt])
}

enum GuildChatMessageType {
  TEXT
  SYSTEM
  ANNOUNCEMENT
  SCRIMMAGE
}

model GuildChatMessage {
  id        String               @id @default(uuid())
  guildId   String
  senderId  String?
  type      GuildChatMessageType @default(TEXT)
  content   String
  isPinned  Boolean              @default(false)
  metadata  Json?
  createdAt DateTime             @default(now())
  guild     Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  sender    Player?              @relation("GuildChatSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt(sort: Desc)])
  @@index([guildId, isPinned])
}

enum WarTacticalMarker {
  TARGET_CALLOUT
  ATTACK_PRIORITY
  SCOUT_FIRST
  CLEARED
}

model GuildWarCallout {
  id               String            @id @default(uuid())
  warId            String
  guildId          String
  defenderPlayerId String
  baseNumber       Int
  marker           WarTacticalMarker @default(TARGET_CALLOUT)
  claimedById      String?
  notes            String?
  assignedById     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  war              GuildWar          @relation(fields: [warId], references: [id], onDelete: Cascade)
  guild            Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  claimedBy        Player?           @relation("WarCalloutClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  assignedBy       Player            @relation("WarCalloutAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([warId, guildId, defenderPlayerId])
  @@index([warId, guildId])
}

enum FriendlyChallengeStatus {
  OPEN
  COMPLETED
  EXPIRED
}

model GuildFriendlyChallenge {
  id             String                  @id @default(uuid())
  guildId        String
  creatorId      String
  message        String?
  status         FriendlyChallengeStatus @default(OPEN)
  attackerId     String?
  stars          Int?
  destructionPct Float?
  replayData     Json?
  createdAt      DateTime                @default(now())
  completedAt    DateTime?
  guild          Guild                   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator        Player                  @relation("CreatedFriendlyChallenges", fields: [creatorId], references: [id], onDelete: Cascade)
  attacker       Player?                 @relation("AttackedFriendlyChallenges", fields: [attackerId], references: [id], onDelete: SetNull)

  @@index([guildId, status])
  @@index([creatorId])
  @@index([attackerId])
}





